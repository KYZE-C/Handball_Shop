@inject ISyncLocalStorageService LocalStorage
@inject ICart_Service Cart_Service
@implements IDisposable

<a href="cart" class="btn" style="padding-right: 10px;background-color: transparent;font-size:0.8rem;">
	<i style="padding-right: 7px;" class="fas fa-cart-arrow-down"></i><p style="padding-right:3px;margin:0;font-size:0.8rem;">Cart</p>
	<span class="pill" style="border: 1px solid white; border-radius: 8px; padding-right:1px;margin-left:5px;height:23px;width:20px;display:flex;align-items:center;justify-content:center;">@GetItemsCount()</span>
</a>



@code {
	protected override void OnInitialized()
	{
		Cart_Service.Onchange += StateHasChanged;
	}
	public void Dispose()
	{
		Cart_Service.Onchange -= StateHasChanged;
	}

	public int GetItemsCount()
	{
		var Cart = LocalStorage.GetItem<List<Variants_Product>>("cart");
		if (Cart != null)
		{
			return Cart.Count;
		}
		else
		{
			return 0;
		}
	}
}
