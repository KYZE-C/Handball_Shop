@inject NavigationManager NavigationManager

<div class="search_wrapper">
    <input class="search_bar" @bind="searchword" type="search" placeholder="Search for a product...">
    <button class="search-btn" @onclick="OnSearch_BTN" type="submit"><i class="fas fa-search"></i></button>
</div>

<style>
    .search_bar {
        inline-size: 20vw;
        height: 40px;
        font-size: 1rem;
        border: 0;
        border-bottom-left-radius: 10px;
        border-top-left-radius: 10px;
    }

    .search-btn {
        width:50px;
        height: 40px;
        border: none;
        border-bottom-right-radius: 10px;
        border-top-right-radius: 10px;
        font-size:1.3rem;
    }

    .search_wrapper {
        --border-color: rgba(255, 255, 255, 0.2);
        padding-top: 0.5rem;
        font-family: "Rubik", sans-serif;
        font-weight: 400;
        color: white;
        font-size: 0.6rem;
        padding-bottom: 1rem;
        border-left: 3px solid var(--border-color);
        border-bottom: 3px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: start;
        width: 18vw;
        padding: 0px 10px 0px 10px;
    }
</style>

@code {
    [Parameter]
    public List<Product> products { get; set; } //list of fitered products set in the navmenu component
    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    private string searchword;

    private async Task OnSearch_BTN()//Called on click of search btn
    {
        if (OnSearch.HasDelegate)//equivlent to OnSearch != null
        {
            await OnSearch.InvokeAsync(searchword);
        }
        NavigationManager.NavigateTo("/Shop");
    }
}
