@page "/"
@inject ISyncLocalStorageService LocalStorage

<AuthorizeView>
	<Authorized>
		<h1>Welcome to Handball Sports Equipment Store @LocalStorage.GetItemAsString("username")</h1>

		<a href="/Shop"><h1>Shop</h1></a>
	</Authorized>
	<NotAuthorized>
		<h1>Welcome to Handball Sports Equipment Store</h1>

		<a href="/Shop"><h1>Shop</h1></a>
	</NotAuthorized>
</AuthorizeView>

